# OpenAI API key (required for real LLM). Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# Model for the Responses API (v1/responses). Default gpt-5-nano. Use if your token has Responses API quota.
# OPENAI_MODEL=gpt-5-nano

# Use mock LLM when quota is exceeded or for demos (no API calls). Set to 1 to enable.
# USE_MOCK_LLM=1

# Port for this service (default 4000)
PORT=4000
